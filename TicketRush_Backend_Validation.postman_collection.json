    {
      "name": "Auth Validation Failures - No Token Needed",
      "item": [
        {
          "name": "Register rejects invalid fields",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"not-email\",\n  \"password\": \"123\",\n  \"fullName\": \"A\",\n  \"dob\": \"2999-01-01\",\n  \"gender\": \"ROBOT\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('returns 400 validation error', function () { pm.response.to.have.status(400); });",
                  "pm.test('has validation error list', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.message).to.eql('Dữ liệu không hợp lệ');",
                  "  pm.expect(json.errors).to.be.an('array').that.is.not.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
