generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  fullName  String
  role      Role      @default(CUSTOMER)
  dob       DateTime?
  gender    Gender?
  createdAt DateTime  @default(now())
  bookings      Booking[]
  events        Event[]              @relation("AdminEvents")
  resetTokens   PasswordResetToken[]

  @@map("users")
}

model Event {
  id          String      @id @default(uuid())
  createdBy   String
  title       String
  description String?
  venue       String
  date        DateTime
  imageUrl    String?
  status          EventStatus @default(DRAFT)
  createdAt       DateTime    @default(now())
  seatmapJson     Json?
  seatmapVersion  Int         @default(1)
  admin           User        @relation("AdminEvents", fields: [createdBy], references: [id])
  zones           Zone[]

  @@map("events")
}

model Zone {
  id        String   @id @default(uuid())
  eventId   String
  name      String
  rows      Int
  cols      Int
  price     Decimal
  createdAt DateTime @default(now())
  seats     Seat[]
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("zones")
}

model Seat {
  id       String     @id @default(uuid())
  zoneId   String
  row      Int
  col      Int
  label    String
  status   SeatStatus @default(AVAILABLE)
  lockedAt DateTime?
  booking  Booking?
  zone     Zone       @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([zoneId, row, col])
  @@map("seats")
}

model Booking {
  id         String        @id @default(uuid())
  userId     String
  seatId     String        @unique
  status     BookingStatus @default(PENDING)
  totalPrice Decimal
  qrCode     String?
  jobId      String?
  createdAt  DateTime      @default(now())
  paidAt     DateTime?
  seat       Seat          @relation(fields: [seatId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id])

  @@map("bookings")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ENDED
}

enum SeatStatus {
  AVAILABLE
  LOCKED
  SOLD
}

enum BookingStatus {
  PENDING
  PAID
  CANCELLED
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}
