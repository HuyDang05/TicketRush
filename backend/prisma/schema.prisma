generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  fullName  String
  role      Role      @default(CUSTOMER)
  dob       DateTime?
  gender    Gender?
  bookings  Booking[]
  events    Event[]   @relation("AdminEvents")
  createdAt DateTime  @default(now())

  @@map("users")
}

model Event {
  id          String      @id @default(uuid())
  createdBy   String
  admin       User        @relation("AdminEvents", fields: [createdBy], references: [id])
  title       String
  description String?
  venue       String
  date        DateTime
  imageUrl    String?
  status      EventStatus @default(DRAFT)
  zones       Zone[]
  createdAt   DateTime    @default(now())

  @@map("events")
}

model Zone {
  id      String    @id @default(uuid())
  eventId String
  event   Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name    String
  rows    Int
  cols    Int
  price   Decimal
  seats   Seat[]
  createdAt DateTime @default(now())

  @@map("zones")
}

model Seat {
  id       String     @id @default(uuid())
  zoneId   String
  zone     Zone       @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  row      Int
  col      Int
  label    String
  status   SeatStatus @default(AVAILABLE)
  lockedAt DateTime?
  booking  Booking?

  @@unique([zoneId, row, col])
  @@map("seats")
}

model Booking {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  seatId     String        @unique
  seat       Seat          @relation(fields: [seatId], references: [id], onDelete: Cascade)
  status     BookingStatus @default(PENDING)
  totalPrice Decimal
  qrCode     String?
  jobId      String?
  createdAt  DateTime      @default(now())
  paidAt     DateTime?

  @@map("bookings")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ENDED
}

enum SeatStatus {
  AVAILABLE
  LOCKED
  SOLD
}

enum BookingStatus {
  PENDING
  PAID
  CANCELLED
}
