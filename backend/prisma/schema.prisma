// Purpose: Dinh nghia hoac seed du lieu Prisma cho database TicketRush.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String  @id @default(uuid())
  email     String  @unique
  password  String
  fullName  String
  avatarUrl String?

  role          Role                 @default(CUSTOMER)
  dob           DateTime?
  gender        Gender?
  createdAt     DateTime             @default(now())
  lastLoginAt   DateTime?
  bookings      Booking[]
  holdSessions  SeatHoldSession[]
  events        Event[]              @relation("AdminEvents")
  resetTokens   PasswordResetToken[]
  refreshTokens RefreshToken[]
  comments      Comment[]

  @@map("users")
}

model Event {
  id             String            @id @default(uuid())
  createdBy      String
  title          String
  description    String?
  venue          String
  category       String?
  geoLat         Float?
  geoLong        Float?
  date           DateTime
  imageUrl       String?
  cardImageUrl   String?
  status         EventStatus       @default(DRAFT)
  createdAt      DateTime          @default(now())
  seatmapJson    Json?
  seatmapVersion Int               @default(1)
  endDate        DateTime?         @map("end_date") @db.Timestamp(6)
  admin          User              @relation("AdminEvents", fields: [createdBy], references: [id])
  zones          Zone[]
  comments       Comment[]
  holdSessions   SeatHoldSession[]

  @@map("events")
}

model Zone {
  id        String   @id @default(uuid())
  eventId   String
  name      String
  rows      Int
  cols      Int
  price     Decimal
  createdAt DateTime @default(now())
  seats     Seat[]
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("zones")
}

model Seat {
  id       String     @id @default(uuid())
  zoneId   String
  row      Int
  col      Int
  label    String
  status   SeatStatus @default(AVAILABLE)
  lockedAt DateTime?
  booking  Booking?
  zone     Zone       @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([zoneId, row, col])
  @@map("seats")
}

model Booking {
  id            String           @id @default(uuid())
  userId        String
  seatId        String           @unique
  holdSessionId String?
  status        BookingStatus    @default(PENDING)
  totalPrice    Decimal
  qrCode        String?
  jobId         String?
  createdAt     DateTime         @default(now())
  paidAt        DateTime?
  holdSession   SeatHoldSession? @relation(fields: [holdSessionId], references: [id], onDelete: SetNull)
  seat          Seat             @relation(fields: [seatId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id])

  @@index([holdSessionId])
  @@map("bookings")
}

model SeatHoldSession {
  id            String            @id @default(uuid())
  userId        String
  eventId       String
  status        HoldSessionStatus @default(ACTIVE)
  expiresAt     DateTime
  cooldownUntil DateTime?
  jobId         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  bookings      Booking[]
  event         Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, eventId, status])
  @@index([expiresAt])
  @@map("seat_hold_sessions")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Comment {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  text      String
  rating    Int
  imageUrl  String?
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("comments")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ENDED
}

enum SeatStatus {
  AVAILABLE
  LOCKED
  SOLD
}

enum BookingStatus {
  PENDING
  PAID
  CANCELLED
}

enum HoldSessionStatus {
  ACTIVE
  EXPIRED
  PAID
  CANCELLED
}
